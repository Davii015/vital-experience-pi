# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA suba o .env real para o GitHub

# Servidor
PORT=3001
NODE_ENV=development

# ─── Supabase PostgreSQL ────────────────────────────────────────────────────
# DATABASE_URL  → usa PgBouncer (pooling) — para o Prisma em runtime
# DIRECT_URL    → conexão direta       — para prisma migrate e prisma db push

DATABASE_URL="postgresql://postgres.PROJECT_REF:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# Substitua:
#   PROJECT_REF → referência do seu projeto no Supabase (ex: abcdefghijklmnop)
#   SUA_SENHA   → senha definida ao criar o projeto no Supabase

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=troque_por_uma_chave_secreta_longa_e_aleatoria_de_pelo_menos_32_chars
JWT_EXPIRES_IN=7d

# ─── Admin padrão ────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@vitalexperience.com
ADMIN_PASSWORD=troque_esta_senha
